{
  "_meta": {
    "title": "故障排查工具（lsof/strace/perf/fuser）命令与 flag 白名单",
    "source": [
      "https://man7.org/linux/man-pages/man8/lsof.8.html",
      "https://man7.org/linux/man-pages/man2/strace.2.html",
