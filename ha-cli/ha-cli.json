    {
      "command": "ha backup",
      "note": "旧版单数，已改为 ha backups（复数）"
    },
    {
      "command": "ha core backup",
      "note": "备份已统一到 ha backups，ha core 下无 backup 子命令"
    },
    {
      "command": "ha supervisor backup",
      "note": "同上，备份在 ha backups"
    },
    {
      "command": "ha addon",
      "note": "旧版单数，已改为 ha addons（复数）"
    },
    {
      "command": "ha supervisor addons",
      "note": "addon 管理统一在 ha addons"
    },
    {
      "command": "ha core status",
      "note": "无此子命令，用 ha core info / ha core stats"
    },
    {
      "command": "ha core show",
      "note": "无此子命令，用 ha core info"
    },
    {
      "command": "ha os datadisk add",
      "note": "无 add，数据盘用 mount/umount 挂载，再 ha os datadisk move"
    },
    {
      "command": "ha os datadisk remove",
      "note": "无 remove，卸载用 umount"
    }
