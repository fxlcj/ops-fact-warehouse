{
  "_meta": {
    "title": "sysstat 性能统计工具（iostat/vmstat/mpstat/sar）命令与 flag 白名单",
    "source": [
      "https://man7.org/linux/man-pages/man8/iostat.8.html",
      "https://man7.org/linux/man-pages/man8/vmstat.8.html",
      "https://man7.org/linux/man-pages/man8/mpstat.8.html",
      "https://man7.org/linux/man-pages/man8/sar.8.html"
    ],
    "checked_date": "2026-11-23",
    "note": "sysstat 套件（iostat 磁盘 / vmstat 内存+swap+cpu / mpstat 每核 cpu / sar 历史采集）。site 性能排查高频（iostat 81 / vmstat 57 / mpstat 21 / sar 8 次）。G4b 对 iostat/vmstat/mpstat/sar flag 做 WARN 扫描（面宽人工核对）。"
  },
  "iostat_flags": [
    {
      "flag": "-x",
      "desc": "扩展统计（avgqu-sz 等，磁盘常用）"
    },
    {
      "flag": "-z",
      "desc": "0 设备也显示"
    },
    {
      "flag": "-m",
      "desc": "块用 MiB"
    },
    {
      "flag": "-s",
      "desc": "扇区统计"
    },
    {
      "flag": "-p",
      "desc": "显示完整路径"
    },
    {
      "flag": "-d",
      "desc": "只磁盘"
    },
    {
      "flag": "-c",
      "desc": "只 cpu"
    },
    {
      "flag": "-t",
      "desc": "带时间戳"
    },
    {
      "flag": "-V",
      "desc": "版本"
    },
    {
      "flag": "-y",
      "desc": "不显示首次（自 0 起的无意义）"
    },
    {
      "flag": "-N",
      "desc": "按设备名显示"
    },
    {
      "flag": "--disk",
      "desc": "磁盘（-d 全写）"
    },
    {
      "flag": "--cpu",
      "desc": "cpu（-c 全写）"
    },
    {
      "flag": "-E"
    },
    {
      "flag": "-h"
    },
    {
      "flag": "-v"
    },
    {
      "flag": "-P"
    }
  ],
  "iostat_fields": [
    {
      "name": "util",
      "desc": "设备繁忙时间占比（%util 饱和看）"
    },
    {
      "name": "await",
      "desc": "IO 等待+服务总时长"
    },
    {
      "name": "r_await",
      "desc": "读 IO 等待"
    },
    {
      "name": "w_await",
      "desc": "写 IO 等待"
    },
    {
      "name": "r-s",
      "desc": "读/s"
    },
    {
      "name": "w-s",
      "desc": "写/s"
    },
    {
      "name": "rkB-s",
      "desc": "读 KB/s"
    },
    {
      "name": "wkB-s",
      "desc": "写 KB/s"
    },
    {
      "name": "svctm",
      "desc": "服务时长（旧版，非严格服务时间）"
    },
    {
      "name": "q-sz",
      "desc": "队列长度"
    },
    {
      "name": "avgqu-sz",
      "desc": "平均队列深度（饱和判断）"
    }
  ],
  "vmstat_flags": [
    {
      "flag": "-1",
      "desc": "每秒采样（1 间隔）"
    },
    {
      "flag": "2",
      "desc": "每 2 秒（间隔参数）"
    },
    {
      "flag": "5",
      "desc": "每 5 秒（间隔参数）"
    },
    {
      "flag": "10",
      "desc": "每 10 秒（间隔参数）"
    },
    {
      "flag": "-n",
      "desc": "不显示表头（每行不重打印）"
    },
    {
      "flag": "-d",
      "desc": "只磁盘统计"
    },
    {
      "flag": "-p",
      "desc": "指定分区"
    },
    {
      "flag": "-s",
      "desc": "系统统计（swap 等）"
    },
    {
      "flag": "-m",
      "desc": "内存统计"
    },
    {
      "flag": "-S",
      "desc": "单位（k 千/M 兆）"
    },
    {
      "flag": "-t",
      "desc": "带时间"
    },
    {
      "flag": "-w",
      "desc": "宽格式（不截断）"
    },
    {
      "flag": "-W",
      "desc": "宽+不截断"
    },
    {
      "flag": "--one",
      "desc": "只显示一次"
    },
    {
      "flag": "-h",
      "desc": "帮助"
    },
    {
      "flag": "-V",
      "desc": "版本"
    }
  ],
