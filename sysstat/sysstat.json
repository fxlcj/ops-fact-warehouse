      "desc": "空闲内存（KB）"
    },
    {
      "name": "buff",
      "desc": "缓冲内存"
    },
    {
      "name": "cache",
      "desc": "页缓存"
    },
    {
      "name": "si",
      "desc": "swap in（KB/s，>0 异常）"
    },
    {
      "name": "so",
      "desc": "swap out（KB/s，>0 异常）"
    },
    {
      "name": "bi",
      "desc": "块 in"
    },
    {
      "name": "bo",
      "desc": "块 out"
    },
    {
      "name": "us",
      "desc": "用户 cpu%"
    },
    {
      "name": "sy",
      "desc": "系统 cpu%"
    },
    {
      "name": "wa",
      "desc": "IO 等待 cpu%（>20 磁盘瓶颈）"
    },
    {
      "name": "st",
      "desc": "steal cpu%（虚拟化）"
    },
    {
      "name": "id",
      "desc": "空闲 cpu%"
    },
    {
      "name": "r",
      "desc": "运行队列长度（>CPU核数 过载）"
    },
    {
      "name": "b",
      "desc": "阻塞进程数（>0 等 IO/内存）"
    }
  ],
