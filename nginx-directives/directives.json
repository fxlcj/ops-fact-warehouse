{
  "_meta": {
    "title": "Nginx 常用指令白名单",
    "source": [
      "https://nginx.org/en/docs/ngx_core_module.html",
      "https://nginx.org/en/docs/http/ngx_http_core_module.html",
      "https://nginx.org/en/docs/http/ngx_http_proxy_module.html",
      "https://nginx.org/en/docs/http/ngx_http_ssl_module.html"
    ],
    "checked_date": "2026-11-22",
    "note": "Nginx 常用指令 80+ 条（core/http/proxy/ssl/limit_conn/limit_req）。文章里 nginx.conf 块中的指令必须在白名单内，否则 G4b WARN。context 字段标注指令适用的配置段（main/http/server/location/if）。"
  },
  "directives": {
    "http": "主配置段 http {} 块",
    "server": "服务器配置段 server {} 块",
    "location": "位置匹配段 location {} 块",
    "if": "条件段 if {} 块",
    "main": "主配置段（worker_* / error_log 等）",
    "events": "事件段 events {} 块",
    "stream": "TCP/UDP 流代理段 stream {} 块"
  },
  "instructions": [
    {
      "directive": "worker_processes",
      "context": "main",
      "desc": "worker 进程数（auto=CPU 核数）"
    },
    {
      "directive": "worker_connections",
      "context": "events",
      "desc": "单 worker 最大连接数"
    },
    {
