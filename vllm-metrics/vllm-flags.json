{
  "_meta": {
    "title": "vLLM 合法 CLI flag 白名单",
    "source": [
      "https://docs.vllm.cc/en/latest/configuration/serve_args.html",
      "vllm serve --help",
      "docs.vllm.com.cn/en/latest/serving/"
    ],
    "checked_date": "2026-11-22",
    "note": "vllm serve 命令行 flag。新增 vLLM 版本可能加 flag，定期对照 release notes 补。"
