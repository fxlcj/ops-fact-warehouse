{
  "_meta": {
    "title": "Kubernetes / kubectl 官方命令与资源白名单",
    "source": [
      "https://kubernetes.io/docs/reference/kubectl/generated/kubectl/",
      "https://kubernetes.io/docs/reference/kubectl/generated/kubectl_get/",
      "https://kubernetes.io/docs/reference/kubernetes-api/"
    ],
    "checked_date": "2026-11-22",
    "note": "kubectl 顶层命令 + get/delete/apply/patch 等资源动词 + 官方资源类型与缩写。用于 G4b 源头遏制：文章里 kubectl <命令> / <资源> 不在白名单 → 告警/阻断。资源缩写来自 kubectl api-resources。"
  },
  "kubectl_commands": [
    {
      "name": "get",
      "desc": "按名称/标签/类型查看资源"
    },
    {
      "name": "describe",
      "desc": "查看资源详情与事件"
    },
    {
      "name": "apply",
      "desc": "按 YAML 声明式应用/更新资源"
    },
    {
      "name": "create",
      "desc": "创建资源（imperative）"
    },
    {
      "name": "delete",
      "desc": "删除资源（可按名称/标签/类型）"
    },
    {
      "name": "exec",
      "desc": "在 Pod 容器内执行命令"
    },
    {
      "name": "logs",
      "desc": "查看容器/POD 日志"
    },
    {
      "name": "rollout",
      "desc": "管理资源滚动更新历史"
    },
    {
      "name": "port-forward",
      "desc": "本地端口转发到资源/节点/服务"
    },
    {
      "name": "top",
      "desc": "查看资源用量（需 metrics-server）"
    },
    {
      "name": "debug",
      "desc": "Pod 节点调试"
    },
    {
      "name": "patch",
      "desc": "按 JSON/YAML/strategic patch 更新资源"
    },
    {
      "name": "scale",
      "desc": "按副本数扩缩 Deployment/StatefulSet"
    },
    {
      "name": "set",
      "desc": "更新已有对象指定字段（image/env/replicas 等）"
    },
    {
      "name": "edit",
      "desc": "在编辑器中编辑资源"
    },
    {
      "name": "wait",
      "desc": "等待资源满足条件"
    },
    {
      "name": "label",
      "desc": "给资源打标签"
    },
    {
      "name": "annotate",
      "desc": "给资源加注解"
    },
    {
      "name": "expose",
      "desc": "把 Service/Deployment 暴露成 Service"
    },
    {
      "name": "run",
      "desc": "创建 Deployment/Job（简化命令，官方建议少用）"
    },
    {
      "name": "config",
      "desc": "管理 kubeconfig 配置"
    },
    {
      "name": "cluster-info",
      "desc": "查看集群信息/控制面地址"
    },
    {
      "name": "version",
      "desc": "查看 kubectl 与 server 版本"
    },
    {
      "name": "events",
      "desc": "列出集群事件（k8s 1.31+ 起 events API 移除，旧用）"
    },
    {
      "name": "explain",
      "desc": "查看资源字段文档"
    },
    {
      "name": "api-resources",
      "desc": "列出集群支持的 API 资源"
    },
    {
      "name": "api-versions",
      "desc": "列出集群 API 版本（旧）"
    },
    {
      "name": "auth",
      "desc": "查看资源访问权限（can-i）"
    },
    {
      "name": "cordon",
      "desc": "把节点标记不可调度"
    },
    {
      "name": "uncordon",
      "desc": "取消节点不可调度标记"
    },
    {
      "name": "drain",
      "desc": "驱逐节点上 Pod（维护排空）"
    },
    {
      "name": "taint",
      "desc": "给节点加污点"
    },
    {
      "name": "attach",
      "desc": "附加到 Pod 标准输入"
    },
    {
      "name": "cp",
      "desc": "在容器与本地间拷贝文件"
    },
    {
      "name": "plugin",
      "desc": "管理 kubectl 插件"
    },
    {
      "name": "diff",
      "desc": "对比集群对象与本地 YAML（kubectl diff，1.33+ 内置）"
    }
