{
  "_meta": {
    "title": "Home Assistant REST API 端点 + Lovelace UI 卡片/视图 type 白名单（HA 知识仓第 3 仓，与 ha-cli/ha-config 互补）",
    "source": [
      "https://www.home-assistant.io/api/",
      "https://www.home-assistant.io/lovelace/",
      "https://www.home-assistant.io/lovelace/cards/",
      "https://www.home-assistant.io/lovelace/views/",
