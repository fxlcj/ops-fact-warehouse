    {
      "flag": "--file",
      "desc": "同 -D"
    },
    {
      "flag": "-g",
      "desc": "globs 匹配"
    },
    {
      "flag": "-m",
      "desc": "合并机器（--machine）"
    },
    {
      "flag": "-q",
      "desc": "静默"
    },
    {
      "flag": "-q",
      "desc": "静默"
    },
    {
      "flag": "-c",
      "desc": "（少见）"
    },
    {
      "flag": "--no-pager",
      "desc": "不翻页"
