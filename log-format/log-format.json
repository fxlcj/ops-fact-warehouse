{
  "_meta": {
    "title": "常用日志格式字段 + 日志排查命令白名单（nginx / syslog / journald / docker / grep / awk）",
    "source": [
      "https://nginx.org/en/docs/http/ngx_http_log_module.html",
      "https://www.freebsd.org/doc/books/base-section/man8/syslogd.html",
      "https://www.freedesktop.org/software/systemd/man/journalctl.html",
      "https://docs.docker.com/config/containers/logging/"
    ],
    "checked_date": "2026-11-23",
    "note": "运维排查文高频：nginx access/error 日志字段（$remote_addr/$status/$request_time 等）、syslog RFC5424 字段、journalctl 常用 flag、docker 日志驱动。G4b 对 nginx 日志变量名、journalctl flag、grep/awk 常用模式做 WARN 扫描。"
  },
  "nginx_log_variables": [
    {
      "name": "$remote_addr",
      "desc": "客户端 IP"
    },
    {
      "name": "$remote_port",
      "desc": "客户端端口"
    },
    {
      "name": "$proxy_add_x_forwarded_for",
      "desc": "XFF 拼接链（取首个是真实客户端 IP）"
    },
    {
      "name": "$http_x_forwarded_for",
      "desc": "XFF 头原值"
    },
    {
      "name": "$http_referer",
      "desc": "Referer 头"
    },
    {
      "name": "$http_user_agent",
      "desc": "User-Agent 头"
    },
    {
      "name": "$request",
      "desc": "完整请求行（method URI proto）"
    },
    {
      "name": "$request_method",
      "desc": "请求方法"
    },
    {
      "name": "$request_uri",
      "desc": "原始 URI（含 query）"
    },
    {
      "name": "$args",
      "desc": "query string"
    },
    {
      "name": "$uri",
      "desc": "重写后 URI"
    },
    {
      "name": "$status",
      "desc": "响应状态码"
    },
    {
      "name": "$body_bytes_sent",
      "desc": "响应体字节"
    },
    {
      "name": "$bytes_sent",
      "desc": "含头的总发送字节"
    },
    {
      "name": "$content_type",
      "desc": "响应 Content-Type"
    },
    {
      "name": "$http_host",
      "desc": "Host 头"
    },
    {
      "name": "$server_name",
      "desc": "命中的 server_name"
    },
    {
      "name": "$server_port",
      "desc": "listen 端口"
    },
    {
      "name": "$time_local",
      "desc": "本地时间"
    },
    {
      "name": "$time_iso8601",
      "desc": "ISO8601 时间"
    },
    {
      "name": "$request_time",
      "desc": "请求处理时长（秒）"
    },
    {
      "name": "$upstream_response_time",
      "desc": "上游响应时长"
    },
    {
      "name": "$upstream_addr",
      "desc": "上游 IP:port"
    },
    {
      "name": "$upstream_status",
      "desc": "上游状态码"
    },
    {
      "name": "$upstream_header_time",
      "desc": "收到上游响应头时长"
    },
    {
      "name": "$upstream_connect_time",
      "desc": "连上游时长"
    },
    {
      "name": "$upstream_send_time",
      "desc": "发请求到上游时长"
    },
    {
      "name": "$upstream_recv_time",
      "desc": "收上游响应时长"
    },
    {
      "name": "$upstream_cache_status",
      "desc": "缓存命中状态"
    },
    {
      "name": "$upstream_bytes_sent",
      "desc": "发给上游字节"
    },
    {
      "name": "$upstream_bytes_received",
      "desc": "收自上游字节"
    },
    {
      "name": "$upstream_header_bytes_sent",
      "desc": "上游响应头字节"
    },
    {
      "name": "$upstream_header_bytes_received",
      "desc": "上游请求头字节"
    },
    {
      "name": "$connection",
      "desc": "连接序号"
    },
    {
      "name": "$connection_requests",
      "desc": "该连接第几次请求"
    },
    {
      "name": "$connection_time",
      "desc": "该连接存在时长"
    },
    {
      "name": "$binary_logs_total_bytes",
      "desc": "（少见）"
    },
    {
      "name": "$msec",
      "desc": "Unix 时间戳（浮点）"
    },
    {
      "name": "$seconds",
      "desc": "Unix 时间戳（整数）"
    },
    {
      "name": "$pid",
      "desc": "worker PID"
    },
    {
      "name": "$host",
      "desc": "Server 变量"
    },
    {
      "name": "$is_args",
      "desc": "是否带 query"
    },
    {
      "name": "$query_string",
      "desc": "同 $args"
    },
    {
      "name": "$scheme",
      "desc": "http/https"
    },
    {
      "name": "$host_upstream",
      "desc": "（少见）"
    },
    {
      "name": "$nginx_version",
      "desc": "nginx 版本"
    }
  ],
  "nginx_log_formats": [
    {
      "name": "combined",
      "desc": "$remote_addr - $remote_user [$time_local] \"$request\" $status $body_bytes_sent \"$http_referer\" \"$http_user_agent\""
    },
    {
      "name": "main",
      "desc": "$remote_addr - $remote_user [$time_local] \"$request\" $status $body_bytes_sent \"$http_referer\" \"$http_user_agent\""
    },
    {
      "name": "url",
      "desc": "纯 $request"
    }
  ],
  "journalctl": [
    {
      "flag": "-u",
      "desc": "按 unit 过滤（-u nginx）"
