  "common_alert_expressions": [
    { "name": "up 探测", "expr": "up{job=\"<job>\"} == 0", "desc": "目标不可达" },
    { "name": "高错误率", "expr": "rate(http_requests_total{code=~\"5..\"}[5m]) / rate(http_requests_total[5m]) > 0.05", "desc": "5xx 占比 > 5%" },
    { "name": "P99 延迟", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, instance)) > 1.0", "desc": "99 分位 > 1s" },
    { "name": "CPU 高", "expr": "1 - (sum(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) by (instance) / sum(rate(node_cpu_seconds_total[5m])) by (instance)) > 0.9", "desc": "CPU > 90%" },
    { "name": "内存低", "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.1", "desc": "可用内存 < 10%" },
    { "name": "磁盘将满", "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100 > 85", "desc": "磁盘使用 > 85%" },
    { "name": "Pod 重启", "expr": "increase(kube_pod_container_status_restarts_total[1h]) > 3", "desc": "1h 内重启 > 3" },
    { "name": "vLLM 抢占", "expr": "rate(vllm:num_preemptions_total[5m]) > 0.1", "desc": "vLLM 抢占率" },
    { "name": "vLLM KV 满", "expr": "vllm:gpu_cache_usage_perc > 0.95", "desc": "GPU KV cache > 95%" }
  ],
  "deprecated": []
}
